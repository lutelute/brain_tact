  <key>StandardErrorPath</key>
  <string>/Users/shigenoburyuto/Documents/GitHub/tool_dev_SGNB/brain_tact/state/dashboard-error.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/shigenoburyuto</string>
  </dict>
</dict>
</plist>
